# Copy to .env and fill in. All .env files are gitignored.

# ---- the narrator -------------------------------------------------------
# Either key works for the workflow front end; the agent front end is OpenAI.
# Leave both blank and the dungeon narrates itself in written prose, fully
# playable. DUNGEON_PROVIDER=openai|anthropic forces one.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# DUNGEON_PROVIDER=
# DM_MODEL=                 # default gpt-4o-mini (agent) / gpt-4.1-mini (workflow)

# ---- the game -----------------------------------------------------------
DM_PROJECT=dungeon-master
DM_REST_SECONDS=20          # campfire length. 120 is the real thing; 20 demos better.

# ---- Catalyst connections ----------------------------------------------
# Two App IDs, because the two front ends are different identities. Generate
# .env.workflow and .env.agent with scripts/refresh-connection; do not put
# DAPR_* in this file.
#   .env.workflow  -> App   dungeon-master
#   .env.agent     -> Agent dungeon-master-agent  (also injected by dev run)
