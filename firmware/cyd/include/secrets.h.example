// Copy to secrets.h and fill in. secrets.h is gitignored.
#pragma once

// The ESP32 is 2.4GHz ONLY. If your router uses one SSID for both bands this
// just works; if 5GHz has its own SSID, use the 2.4GHz one here.
#define WIFI_SSID     "your-2.4GHz-ssid"
#define WIFI_PASSWORD "your-password"

// The machine running `python -m dungeon_master.bridge.server`.
// Its LAN address, not localhost.
#define BRIDGE_HOST "192.168.86.26"
#define BRIDGE_PORT 8080

// LEAVE THIS COMMENTED OUT. Each board then derives its own slot from its
// chip's unique MAC -- "cyd-a4f2b1" or similar -- so four boards flashed from
// this one file get four separate adventures instead of fighting over one
// save. Uncomment only to pin a specific board to a specific adventure.
// #define GAME_SLOT "cyd-1"
